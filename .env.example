# GENSA Admin Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ===========================================
# Database (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gensa_db
DB_USER=gensa_user
DB_PASS=your_secure_password

# ===========================================
# Session / Auth
# ===========================================
# Session duration in milliseconds (7 days default)
# SESSION_DURATION_MS=604800000

# ===========================================
# Media Storage
# ===========================================
# Local upload path (relative to project root or absolute)
# Default: ./public/uploads
# For production with persistent volume: /var/www/uploads
MEDIA_UPLOAD_PATH=./public/uploads

# Optional: Base URL for media files (if using CDN/object storage)
# MEDIA_BASE_URL=https://cdn.your-domain.com

# ===========================================
# External Services (Optional)
# ===========================================
# For sitemap.xml and SEO
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Unsplash (for placeholder images in development)
# No config needed - uses images.unsplash.com

# ===========================================
# Logging / Monitoring (Optional)
# ===========================================
# LOG_LEVEL=info
# SENTRY_DSN=https://xxx@sentry.io/xxx